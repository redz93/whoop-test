{%- paginate search.results by 12 -%}
<section class="section" style="padding-top:calc(var(--head) + 32px)">
  <div class="wrap">
    <h1 class="display" style="font-size:clamp(2.4rem,7vw,5rem);margin-bottom:28px">{{ 'general.search' | t }}</h1>
    <form action="{{ routes.search_url }}" method="get" style="display:flex;gap:12px;max-width:640px;margin-bottom:40px">
      <input class="field" type="search" name="q" value="{{ search.terms | escape }}" placeholder="{{ 'search.placeholder' | t }}" aria-label="{{ 'general.search' | t }}"><button class="btn" type="submit">{{ 'general.search' | t }}</button>
    </form>
    {%- if search.performed -%}
      <div class="grid">
        {%- for item in search.results -%}
          {%- if item.object_type == 'product' -%}{% render 'product-card', product: item %}
          {%- else -%}<a class="card__title" href="{{ item.url }}">{{ item.title }}</a>{%- endif -%}
        {%- else -%}<div class="empty">{{ 'search.no_results' | t: terms: search.terms }}</div>{%- endfor -%}
      </div>
      {%- if paginate.pages > 1 -%}<div class="pagination">{{ paginate | default_pagination }}</div>{%- endif -%}
    {%- endif -%}
  </div>
</section>
{%- endpaginate -%}
{% schema %}
{"name":"Recherche"}
{% endschema %}
