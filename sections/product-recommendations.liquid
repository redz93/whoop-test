<section class="section" style="padding-block:clamp(40px,7vw,90px)">
  <div class="wrap">
    <div class="head-row"><h2 class="h2">{{ section.settings.heading }}</h2></div>
    <div class="grid" style="grid-template-columns:repeat({{ section.settings.columns }},1fr)" data-recs data-url="{{ routes.product_recommendations_url }}?section_id={{ section.id }}&product_id={{ product.id }}&limit=4&intent={{ section.settings.intent }}">
      {%- if recommendations.performed and recommendations.products_count > 0 -%}
        {%- for product in recommendations.products -%}{% render 'product-card', product: product %}{%- endfor -%}
      {%- endif -%}
    </div>
  </div>
</section>
{% schema %}
{"name":"Recommandations produit","settings":[
{"type":"text","id":"heading","label":"Titre","default":"Complète ton look"},
{"type":"select","id":"intent","label":"Type","default":"related","options":[{"value":"related","label":"Produits similaires"},{"value":"complementary","label":"Produits complémentaires"}]},
{"type":"range","id":"columns","label":"Colonnes","min":2,"max":4,"step":1,"default":4}],
"presets":[{"name":"Recommandations produit"}]}
{% endschema %}
