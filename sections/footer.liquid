<footer class="footer">
  <div class="wrap">
    <div class="footer__top">
      <div>
        <a class="logo" href="{{ routes.root_url }}">{{ settings.brand_name }}</a>
        {%- if section.settings.tagline != blank -%}<p class="lead" style="margin-top:14px">{{ section.settings.tagline }}</p>{%- endif -%}
        <div class="nl-mini">{% render 'newsletter-form', form_id: 'footer-nl' %}</div>
        <div class="social">
          {%- if settings.instagram != blank -%}<a href="{{ settings.instagram }}" target="_blank" rel="noopener" aria-label="Instagram">{% render 'icon', name: 'instagram' %}</a>{%- endif -%}
          {%- if settings.tiktok != blank -%}<a href="{{ settings.tiktok }}" target="_blank" rel="noopener" aria-label="TikTok">{% render 'icon', name: 'tiktok' %}</a>{%- endif -%}
        </div>
      </div>
      {%- for block in section.blocks -%}
        <div {{ block.shopify_attributes }}>
          <h4>{{ block.settings.heading }}</h4>
          {%- if block.settings.menu != blank -%}<ul>{%- for l in block.settings.menu.links -%}<li><a href="{{ l.url }}">{{ l.title }}</a></li>{%- endfor -%}</ul>{%- endif -%}
          {%- if block.settings.text != blank -%}<div class="prose">{{ block.settings.text }}</div>{%- endif -%}
        </div>
      {%- endfor -%}
    </div>
    <div class="footer__bot">
      <span>© {{ 'now' | date: '%Y' }} {{ shop.name }}. Appareils WHOOP : marque de leur propriétaire respectif, mentionnée uniquement pour la compatibilité.</span>
      <ul style="display:flex;gap:20px;flex-wrap:wrap">{%- for p in shop.policies -%}<li><a href="{{ p.url }}">{{ p.title }}</a></li>{%- endfor -%}</ul>
    </div>
  </div>
</footer>
{% schema %}
{"name":"Pied de page","settings":[{"type":"text","id":"tagline","label":"Slogan","default":"Un bracelet pour chaque occasion."}],
"blocks":[{"type":"links","name":"Liens","limit":4,"settings":[{"type":"text","id":"heading","label":"Titre","default":"Boutique"},{"type":"link_list","id":"menu","label":"Menu"},{"type":"richtext","id":"text","label":"Texte (contact, adresse…)"}]}],
"default":{"blocks":[{"type":"links","settings":{"heading":"Boutique","menu":"footer"}},{"type":"links","settings":{"heading":"Aide","menu":"footer"}},{"type":"links","settings":{"heading":"Contact","text":"<p>contact@votre-boutique.com</p>"}}]}}
{% endschema %}
