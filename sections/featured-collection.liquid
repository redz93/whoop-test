{%- assign coll = section.settings.collection | default: collections.all -%}
<section class="section">
  <div class="wrap">
    <div class="head-row reveal"><h2 class="h2">{{ section.settings.heading }}</h2><a class="link-u" href="{{ coll.url }}">{{ 'general.view_all' | t }}</a></div>
    <div class="grid">
      {%- for product in coll.products limit: section.settings.limit -%}
        <div class="reveal" style="--d:{{ forloop.index0 | modulo: 3 | times: 0.08 }}s">{% render 'product-card', product: product %}</div>
      {%- else -%}
        <div class="empty">{{ 'general.no_products' | t }}</div>
      {%- endfor -%}
    </div>
  </div>
</section>
{% schema %}
{"name":"Collection en vedette (best sellers)","settings":[
{"type":"text","id":"heading","label":"Titre","default":"Best sellers"},
{"type":"collection","id":"collection","label":"Collection","info":"Sans choix : tous les produits. Astuce : créez une collection « Best sellers »."},
{"type":"range","id":"limit","label":"Nombre de produits","min":3,"max":12,"step":3,"default":6}],
"presets":[{"name":"Best sellers"}]}
{% endschema %}
